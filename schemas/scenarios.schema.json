{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosilicon.local/schemas/scenarios.schema.json",
  "title": "Discrete-event scenarios (V3, CS-08)",
  "type": "object",
  "required": ["schemaVersion", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "_comment": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "excluded", "resources", "tasks"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^sc-[a-z0-9-]+$" },
          "label": { "$ref": "common.schema.json#/$defs/i18nText" },
          "description": { "$ref": "common.schema.json#/$defs/i18nText" },
          "excluded": { "$ref": "common.schema.json#/$defs/i18nText" },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "capacity", "capacityAssumption"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "kind": { "enum": ["cpu", "ram", "gpu", "storage", "network", "display", "other"] },
                "capacity": { "type": "integer", "minimum": 1, "maximum": 64 },
                "capacityAssumption": { "$ref": "common.schema.json#/$defs/i18nText" }
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["id", "measurementId", "resourceId", "dependsOn"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "measurementId": { "$ref": "common.schema.json#/$defs/id" },
                "resourceId": { "type": ["string", "null"] },
                "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
