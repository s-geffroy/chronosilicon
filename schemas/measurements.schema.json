{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosilicon.local/schemas/measurements.schema.json",
  "title": "Measurements (curated, original units)",
  "type": "object",
  "required": ["schemaVersion", "measurements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } }
  },
  "$defs": {
    "statistics": {
      "type": "object",
      "required": ["sampleCount", "method", "quantiles"],
      "additionalProperties": false,
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "method": { "type": "string", "minLength": 1 },
        "quantiles": {
          "type": "array",
          "items": {
            "type": "object", "required": ["p", "value"], "additionalProperties": false,
            "properties": { "p": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }, "value": { "type": "number", "minimum": 0 } }
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["id", "phenomenonId", "configuration", "value", "unit", "low", "high", "conditions", "protocol", "provenanceType", "verificationStatus", "sourceIds", "locator", "quote", "era", "uncertainty", "statistics", "calculation", "rawRef", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "phenomenonId": { "$ref": "common.schema.json#/$defs/id" },
        "configuration": { "type": ["string", "null"], "description": "Named hardware/software configuration (architecture, model, version) the value applies to." },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "low": { "type": ["number", "null"], "minimum": 0 },
        "high": { "type": ["number", "null"], "minimum": 0 },
        "conditions": { "$ref": "common.schema.json#/$defs/i18nText" },
        "protocol": { "type": ["string", "null"] },
        "provenanceType": { "$ref": "common.schema.json#/$defs/provenanceType" },
        "verificationStatus": { "$ref": "common.schema.json#/$defs/verificationStatus" },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src-[a-z0-9-]+$" } },
        "locator": { "type": "string", "minLength": 1 },
        "quote": { "type": ["string", "null"], "maxLength": 300 },
        "era": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2100 },
        "uncertainty": { "type": "null", "description": "Unknown uncertainty is an explicit null (CS-04). Structured uncertainty reserved for V5." },
        "statistics": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/statistics" }] },
        "calculation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "required": ["formula", "inputs"], "additionalProperties": false,
              "properties": { "formula": { "type": "string", "minLength": 1 }, "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
            }
          ]
        },
        "rawRef": { "type": "string", "minLength": 1, "description": "file#itemId in data/raw (immutable extraction record)." },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
