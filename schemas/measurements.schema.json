{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosilicon.local/schemas/measurements.schema.json",
  "title": "Measurements (curated, original units)",
  "type": "object",
  "required": [
    "schemaVersion",
    "measurements"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "$defs": {
    "statistics": {
      "type": "object",
      "required": [
        "sampleCount",
        "sampleCountNote",
        "method",
        "quantiles"
      ],
      "additionalProperties": false,
      "properties": {
        "sampleCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Independent units behind the statistic as stated by the source (runs, subjects, queries). null only when the source does not publish it."
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "quantiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "p",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "p": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "sampleCountNote": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "description": "Required when sampleCount is null: what the source says (or not) about n."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sampleCount": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "sampleCountNote": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "required": [
        "id",
        "phenomenonId",
        "configuration",
        "value",
        "unit",
        "low",
        "high",
        "conditions",
        "protocol",
        "provenanceType",
        "verificationStatus",
        "sourceIds",
        "locator",
        "quote",
        "era",
        "uncertainty",
        "statistics",
        "calculation",
        "rawRef",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "phenomenonId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "configuration": {
          "type": [
            "string",
            "null"
          ],
          "description": "Named hardware/software configuration (architecture, model, version) the value applies to."
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "conditions": {
          "$ref": "common.schema.json#/$defs/i18nText"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenanceType": {
          "$ref": "common.schema.json#/$defs/provenanceType"
        },
        "verificationStatus": {
          "$ref": "common.schema.json#/$defs/verificationStatus"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          }
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "era": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2100
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uncertainty"
            }
          ],
          "description": "Unknown uncertainty is an explicit null (CS-04)."
        },
        "statistics": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/statistics"
            }
          ]
        },
        "calculation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "formula",
                "inputs"
              ],
              "additionalProperties": false,
              "properties": {
                "formula": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "rawRef": {
          "type": "string",
          "minLength": 1,
          "description": "file#itemId in data/raw (immutable extraction record)."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "description": "Dispersion or uncertainty AS PUBLISHED by the source (CS-04, CS-06). Never computed or guessed by the project.",
      "required": [
        "type",
        "value",
        "low",
        "high",
        "level",
        "sampleCount",
        "statement",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "standard-deviation",
            "standard-error",
            "unspecified-plus-minus",
            "confidence-interval"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Half-width in the measurement unit (± value) for standard-deviation, standard-error, unspecified-plus-minus; null for confidence-interval."
        },
        "low": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "confidence-interval only, measurement unit."
        },
        "high": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "confidence-interval only, measurement unit."
        },
        "level": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "confidence-interval only (e.g. 0.95)."
        },
        "sampleCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Literal wording of the source (e.g. 'mean ± s.e.')."
        },
        "locator": {
          "type": "string",
          "minLength": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "confidence-interval"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "level": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              },
              "low": {
                "type": "null"
              },
              "high": {
                "type": "null"
              },
              "level": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "standard-error"
              }
            }
          },
          "then": {
            "properties": {
              "sampleCount": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
