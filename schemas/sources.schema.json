{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosilicon.local/schemas/sources.schema.json",
  "title": "Evidence registry (sources)",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id", "title", "author", "publisher", "url", "doi", "publishedDate", "version", "accessedAt", "license", "redistribution", "accessNotes", "verificationStatus"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": ["string", "null"] },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "doi": { "type": ["string", "null"] },
        "publishedDate": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "accessedAt": { "$ref": "common.schema.json#/$defs/date" },
        "license": { "type": "string", "minLength": 1 },
        "redistribution": { "$ref": "common.schema.json#/$defs/redistribution" },
        "accessNotes": { "type": "string" },
        "verificationStatus": { "$ref": "common.schema.json#/$defs/verificationStatus" }
      }
    }
  }
}
