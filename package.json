{
  "name": "chronosilicon",
  "private": true,
  "version": "0.1.0",
  "description": "CHRONOSILICON — An Open Atlas of Computational Time",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run -w @chronosilicon/web check",
    "build:data": "tsx scripts/build-corpus.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "test": "vitest run",
    "build": "npm run build:data && npm run -w @chronosilicon/web build",
    "preview": "npm run -w @chronosilicon/web preview",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run validate:data && npm test && npm run build",
    "curate": "tsx scripts/curate.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.4",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vite": "8.3.8"
  }
}
